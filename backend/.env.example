# PostgreSQL 连接串（应用使用异步驱动）
DATABASE_URL=postgresql+asyncpg://forum:forum@localhost:5432/forum
# Redis 连接串（缓存 + Celery Broker）
REDIS_URL=redis://localhost:6379/0
# JWT 签名密钥（生产环境必须替换为随机 64 字节）
SECRET_KEY=change-me-to-a-random-64-byte-secret
# Access / Refresh Token 有效期
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# 允许的 CORS 来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173
# 上传目录
UPLOAD_DIR=./uploads

# ---- 安全加固（v0.1.0） ----
# 首个注册用户自动成为管理员（开发/初始化用；生产请设为 false，并用引导脚本创建管理员）
ADMIN_BOOTSTRAP=true
# 通用 API 限流：每分钟每 IP 请求上限
API_RATE_LIMIT=120
# 登录/注册接口限流：窗口内允许次数
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=60

# ---- 以下为可选外部服务配置（骨架阶段可留空） ----
SMS_PROVIDER=
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=
PUSH_PROVIDER=
PUSH_APP_KEY=
OAUTH_WECHAT_CLIENT_ID=
OAUTH_WECHAT_CLIENT_SECRET=
OAUTH_QQ_CLIENT_ID=
OAUTH_QQ_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- AI 自动审核（OpenAI 兼容协议：DeepSeek / 通义千问 / 智谱等） ----
AI_ENABLED=false
# llm=真实调用大模型 / mock=确定性模拟（本地演示与自动化测试，无需 API Key）
AI_MODE=llm
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 图片审核视觉模型（如 qwen-vl-max / gpt-4o-mini）；留空则回退用 AI_MODEL
AI_VISION_MODEL=
AI_AUDIT_MODE=async
AI_AUDIT_THRESHOLD=0.6

# ---------- Uvicorn 运行配置（由 backend/run.sh 或 run.ps1 加载生效） ----------
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
UVICORN_RELOAD=true
UVICORN_WORKERS=1
UVICORN_LOG_LEVEL=info
